{
  "name": "folk-dance-player",
  "productName": "Folk Dance Player",
  "version": "0.2.0",
  "description": "A music player for folk dance organizers",
  "author": "Evan Kaiser",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && env -u ELECTRON_RUN_AS_NODE playwright test",
    "test:e2e:dist": "env -u ELECTRON_RUN_AS_NODE FDP_APP=\"dist/mac-universal/Folk Dance Player.app\" playwright test",
    "format": "prettier --write .",
    "build:helper": "sh scripts/build-helper.sh",
    "dist": "npm run build && npm run build:helper && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --publish never",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/make-icon.cjs",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@tanstack/react-virtual": "3.14.20",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.3",
    "music-metadata": "11.16.1",
    "plist": "5.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
